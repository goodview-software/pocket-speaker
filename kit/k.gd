## Raccourcis
static func label(parent: Node, text: String, size := Tokens.FS_BASE, color: Variant = null, weight := 400, wrap := true) -> Label:
	return KS.label(parent, text, size, color, weight, wrap)
static func muted(parent: Node, text: String, size := Tokens.FS_SM) -> Label:
	return KS.label(parent, text, size, Tokens.text_muted, 400, true)
static func theme() -> Theme:
	return ThemeBuilder.build()
